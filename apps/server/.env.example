[TEMPLATE]
# Hearth server environment configuration.
# Copy to .env.local and fill in real values. Never commit .env.local.

# ---- Server ----
PORT=4318
# Public origin used for invite links and cookie scope. No trailing slash.
# On Render this defaults to RENDER_EXTERNAL_URL automatically — unset here.
PUBLIC_ORIGIN=http://localhost:5173
# Directory for the local SQLite database file and uploaded media (will be created).
# Ignored when LIBSQL_URL is set (remote database mode).
DATA_DIR=./data

# ---- Database ----
# Development (default): local SQLite file under DATA_DIR.
# Production (ephemeral hosts): remote libSQL/Turso database — set both:
#   LIBSQL_URL=libsql://<your-db>-<your-org>.turso.io
#   LIBSQL_AUTH_TOKEN=<token from turso db tokens create>
# The entire synchronous data layer works unchanged on both drivers.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# ---- Media storage ----
# Development (default): files under DATA_DIR/media.
# Production: Backblaze B2 private bucket (10 GB free, no card). Set all five:
#   B2_KEY_ID, B2_APP_KEY  — application key (create one limited to the bucket)
#   B2_BUCKET_ID, B2_BUCKET_NAME — from the bucket details page
#   B2_S3_REGION — e.g. us-west-004 (S3 endpoint region)
# Downloads stay private: proxied through /api/media/file/:id with authz checks;
# the bucket itself never serves the public internet.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_S3_REGION=

# ---- Scheduler (GitHub Actions) ----
# Bearer secret for POST /api/admin/cron/weekly (weekly Truth-or-Dare trigger).
# Put the same value in GitHub Secrets as HEARTH_CRON_SECRET; fails closed if unset.
HEARTH_CRON_SECRET=
# Set to 1 on hosts that spin down (Render free) — in-process cron is unreliable there.
HEARTH_DISABLE_CRON=

# ---- Secrets ----
# 64-hex-char random secrets. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-openssl-rand-hex-32
MEDIA_SIGNING_SECRET=replace-me-with-openssl-rand-hex-32
# Comma-separated usernames that receive platform admin on first login/seed.
PLATFORM_ADMIN_USERNAMES=admin

# ---- Content pipeline ----
# Cron schedule for weekly Truth-or-Dare publication (default: Sunday 03:00 server time).
# Only used when HEARTH_DISABLE_CRON is not 1.
CONTENT_CRON=0 3 * * 0
# Items per weekly batch (spec target: 3000-4000).
CONTENT_BATCH_SIZE=3500
# Optional AI provider key. If unset, the curated static library is ingested instead.
# Server-side only — never referenced by frontend code.
CONTENT_AI_API_KEY=
CONTENT_AI_PROVIDER=

# ---- Email (password reset) ----
# Without SMTP, reset links are written to the server log only (documented limitation).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hearth <no-reply@hearth.example>
