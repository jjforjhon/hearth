{
  "name": "hearth-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Hearth — a multiplayer social gaming platform. Play together. Talk more. Discover each other.",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "npm run dev -w @hearth/server",
    "dev:web": "npm run dev -w @hearth/web",
    "build:web": "npm run build -w @hearth/web",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "db:reseed": "npm run db:reseed -w @hearth/server"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.6"
  }
}
